---
import ContactSection from '../components/portfolio/ContactSection.astro';
import EducationSection from '../components/portfolio/EducationSection.astro';
import ExperienceTimeline from '../components/portfolio/ExperienceTimeline.astro';
import Hero from '../components/portfolio/Hero.astro';
import ProfileSection from '../components/portfolio/ProfileSection.astro';
import TechnologySection from '../components/portfolio/TechnologySection.astro';
import TopNavigation from '../components/portfolio/TopNavigation.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="site-navigation sticky top-0 z-40">
		<div class="mx-auto w-[min(1120px,calc(100%-24px))] sm:w-[min(1120px,calc(100%-32px))]">
			<TopNavigation />
		</div>
	</div>
	<main class="mx-auto w-[min(1120px,calc(100%-24px))] pb-14 sm:w-[min(1120px,calc(100%-32px))]">
		<Hero />
		<div data-reveal><ProfileSection /></div>
		<div data-reveal><TechnologySection /></div>
		<ExperienceTimeline />
		<div data-reveal><EducationSection /></div>
		<ContactSection />
	</main>
</Layout>
