---
import ScrollToTopButton from '../components/portfolio/ScrollToTopButton.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Rogelio García Peña | Full Stack Developer',
	description = 'Portfolio profesional de Rogelio García Peña, desarrollador Full Stack con experiencia en React, Next.js, Vue, PHP, Strapi y arquitecturas backend.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			let storedTheme = null;
			let systemTheme = 'light';

			try {
				storedTheme = localStorage.getItem('theme');
			} catch {
				storedTheme = null;
			}

			try {
				systemTheme = window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			} catch {
				systemTheme = 'light';
			}

			const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : systemTheme;
			document.documentElement.dataset.theme = theme;
			document.documentElement.style.colorScheme = theme;
		</script>
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<ScrollToTopButton />
	</body>
</html>
