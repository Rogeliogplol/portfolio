---
import { contactItems } from '../../data/portfolio';
import MailIcon from '../icons/MailIcon.astro';
import LinkedInIcon from '../icons/LinkedInIcon.astro';
import DownloadIcon from '../icons/DownloadIcon.astro';
---

<section id="contacto" class="full-bleed border-t border-[rgb(var(--border))] pt-11 sm:pt-16" aria-labelledby="contact-title">
	<div class="section-inner grid gap-8 rounded-[28px] border border-[rgb(var(--border))] bg-[rgb(var(--surface)/0.72)] p-8 shadow-[0_24px_70px_rgb(var(--shadow))] lg:grid-cols-[minmax(0,1fr)_360px]">
		<div data-reveal>
			<p class="mb-3 text-xs font-bold uppercase tracking-[0.12em] text-[rgb(var(--accent))]">Contacto</p>
			<h2 id="contact-title" class="mb-4 text-4xl font-bold leading-none tracking-[-0.045em] text-[rgb(var(--text))] sm:text-5xl">
				Disponible para nuevas oportunidades
			</h2>
			<p class="text-lg leading-8 text-[rgb(var(--muted))]">
				Portfolio orientado a búsqueda de empleo. Puedes contactar conmigo por correo o LinkedIn.
				También puedes descargar mi CV en PDF.
			</p>
		</div>
		<div class="flex content-start flex-wrap gap-2.5" aria-label="Enlaces de contacto">
			{contactItems.map((item) => {
				const content = `${item.label} · ${item.value}`;
				const className = "inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-[rgb(var(--border))] bg-[rgb(var(--surface)/0.66)] px-3.5 font-semibold text-[rgb(var(--text-soft))] no-underline transition-colors hover:bg-[rgb(var(--surface))] hover:text-[rgb(var(--text))] focus-visible:bg-[rgb(var(--surface))] focus-visible:text-[rgb(var(--text))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgb(var(--accent))] sm:min-h-10 sm:min-w-0";

				return item.href ? (
					<a data-reveal class={className} href={item.href} download={item.download} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
						{item.label === 'Email' && <MailIcon class="size-5 sm:hidden" />}
						{item.label === 'LinkedIn' && <LinkedInIcon class="size-5 sm:hidden" />}
						{item.label === 'CV' && <DownloadIcon class="size-5 sm:hidden" />}
						<span class="sr-only sm:not-sr-only">{content}</span>
					</a>
				) : (
					<span data-reveal class={className}>{content}</span>
				);
			})}
		</div>
	</div>
</section>
