---
import { education } from '../../data/portfolio';
---

<section id="formacion" class="full-bleed border-t border-[rgb(var(--border))] py-11 sm:py-16">
	<div class="section-inner grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
		<div>
			<p class="mb-3 text-xs font-bold uppercase tracking-[0.12em] text-[rgb(var(--accent))]">Formación</p>
			<h2 class="mb-0 text-4xl font-bold leading-none tracking-[-0.045em] text-[rgb(var(--text))] sm:text-5xl">Base académica</h2>
		</div>
		<ul class="list-disc space-y-3 pl-5 pt-1 text-lg leading-relaxed text-[rgb(var(--subtle))]">
			{education.map((item) => <li>{item}</li>)}
		</ul>
	</div>
</section>
