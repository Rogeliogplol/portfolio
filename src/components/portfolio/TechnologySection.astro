---
import SectionHeading from './SectionHeading.astro';
import { technologies } from '../../data/portfolio';
---

<section class="border-t border-[rgb(var(--border))] py-11 sm:py-16" aria-labelledby="skills-title">
	<SectionHeading kicker="Tecnologías" title="Stack y herramientas habituales" id="skills-title" />
	<div class="flex flex-wrap gap-2.5">
		{technologies.map((technology) => (
			<span class="inline-flex min-h-10 items-center rounded-full border border-[rgb(var(--border))] bg-[rgb(var(--surface)/0.66)] px-3.5 font-semibold text-[rgb(var(--text-soft))]">
				{technology}
			</span>
		))}
	</div>
</section>
