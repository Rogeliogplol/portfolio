---
import MoonIcon from '../icons/MoonIcon.astro';
import SunIcon from '../icons/SunIcon.astro';
---

<button
	class="theme-toggle relative inline-flex h-11 w-20 shrink-0 items-center rounded-full border border-[rgb(var(--border))] bg-[rgb(var(--surface)/0.78)] p-1 shadow-[0_18px_50px_rgb(var(--shadow))] transition-colors hover:bg-[rgb(var(--surface))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgb(var(--accent))]"
	type="button"
	role="switch"
	aria-label="Tema oscuro"
	aria-checked="false"
	data-theme-state="light"
	data-theme-toggle
>
	<span class="absolute left-3 grid place-items-center text-[rgb(var(--accent))]" aria-hidden="true">
		<SunIcon class="size-4" />
	</span>
	<span class="absolute right-3 grid place-items-center text-[rgb(var(--accent))]" aria-hidden="true">
		<MoonIcon class="size-4" />
	</span>
	<span
		class="absolute left-1 size-9 rounded-full bg-[rgb(var(--accent))] shadow-sm transition-transform duration-200 data-[theme-state=dark]:translate-x-9"
		aria-hidden="true"
		data-theme-state="light"
		data-theme-toggle-thumb
	></span>
</button>

<script>
	import { initializeThemeToggle } from '../../utils/themeToggle';

	document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
		initializeThemeToggle(button);
	});
</script>
